{
  "id": "opencc-1512",
  "title": "tw2sp turns every 執行 into 运行",
  "repo": "https://github.com/BYVoid/OpenCC",
  "upstream_pr": "https://github.com/BYVoid/OpenCC/pull/1512",
  "upstream_status": "merged",
  "merge_commit": "bcf847cf3fbd79c74779567f9a491ea8ab878183",
  "base_commit": "4b030216275f62e2731975d0152e092053b768f7",
  "language": "data",
  "category": "locale-terminology",
  "license": "Apache-2.0",
  "environment": {
    "reproduces_on": [
      "any"
    ],
    "locale": null,
    "tz": null,
    "toolchain": {
      "python": ">=3.9",
      "opencc (PyPI)": "1.4.2, the version of the base commit"
    },
    "notes": "No C++ build: tools/opencc_testcases.py builds text dictionaries from the checkout as data/CMakeLists.txt does with OPENCC_DICT_FORMAT=text and runs test/testcases/testcases.json with the PyPI engine. Upstream's C++ dictionary checks (sort order, reverse-mapping completeness) are not run."
  },
  "python_venv": true,
  "setup": [
    [
      "{python}",
      "-m",
      "pip",
      "install",
      "-q",
      "--disable-pip-version-check",
      "opencc==1.4.2"
    ]
  ],
  "test_command": [
    "{python}",
    "{bench}/tools/opencc_testcases.py",
    "{workdir}",
    "--only-prefix",
    "BYVoid_OpenCC_Issue_1313_zhixing_not_generic_tw2sp",
    "--only-prefix",
    "BYVoid_OpenCC_Issue_1313_zhixing_s2twp"
  ],
  "regression_command": [
    "{python}",
    "{bench}/tools/opencc_testcases.py",
    "{workdir}",
    "--skip-prefix",
    "BYVoid_OpenCC_Issue_1313_zhixing_not_generic_tw2sp",
    "--skip-prefix",
    "BYVoid_OpenCC_Issue_1313_zhixing_s2twp"
  ],
  "hidden_tests": {
    "source": "upstream-pr",
    "tests": [
      "test/testcases/testcases.json: BYVoid_OpenCC_Issue_1313_zhixing_not_generic_tw2sp",
      "test/testcases/testcases.json: BYVoid_OpenCC_Issue_1313_zhixing_s2twp"
    ]
  },
  "gold_patch": "gold.patch",
  "test_patch": "test.patch",
  "timeout_sec": 900
}
